    "imapflow": "^2.0.0",
    "mailparser": "^3.9.23",
    "nodemailer": "^10.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
