{
  "name": "postaci",
  "productName": "Postacı",
  "version": "1.0.26",
  "description": "Yıldırım hızında, güvenli, modern ve şık masaüstü e-posta istemcisi",
  "author": {
    "name": "Ekrem Eşref Kılınç",
    "email": "ekilinc@mehmetakif.edu.tr",
    "url": "https://github.com/eekilinc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eekilinc/Postaci.git"
  },
  "homepage": "https://github.com/eekilinc/Postaci",
  "license": "MIT",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "prestart": "node scripts/brand-dev.cjs",
    "start": "concurrently -k \"npm run dev\" \"npm run electron\"",
    "electron": "wait-on tcp:127.0.0.1:5173 && electron .",
    "brand-electron": "node scripts/brand-dev.cjs",
    "postinstall": "node scripts/brand-dev.cjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "electron-build": "npm run build && electron-builder",
    "version:patch": "npm version patch && git push && git push --tags",
    "version:minor": "npm version minor && git push && git push --tags",
    "version:major": "npm version major && git push && git push --tags",
    "release:patch": "npm version patch && git push && git push --tags",
    "release:minor": "npm version minor && git push && git push --tags",
    "release:major": "npm version major && git push && git push --tags"
  },
  "build": {
    "appId": "com.postaci.app",
    "productName": "Postacı",
    "copyright": "Copyright © 2026 Ekrem Eşref Kılınç",
    "icon": "build/icon.ico",
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "main.cjs",
      "preload.cjs",
      "package.json",
      "public/**/*",
      "build/**/*",
      "!**/*.map"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*",
      "public/**/*",
      "build/**/*"
    ],
    "win": {
      "executableName": "Postaci",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Postacı",
      "uninstallDisplayName": "${productName} ${version}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Postaci-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Postaci-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.5",
    "dompurify": "^3.4.15",
    "fast-xml-parser": "^5.11.1",
    "imapflow": "^2.0.0",
    "mailparser": "^3.9.23",
    "nodemailer": "^10.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
